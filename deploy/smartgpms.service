[Unit]
Description=smartGPMS gate-pass verification service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@WORKING_DIRECTORY@
Environment="SMARTGPMS_DATA_DIR=@DATA_DIRECTORY@"
Environment="SMARTGPMS_RUN_MODE=server"
Environment="PYTHONUNBUFFERED=1"
ExecStart="@PYTHON_EXECUTABLE@" -m uvicorn app:app --host "@HOST@" --port @PORT@ --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
